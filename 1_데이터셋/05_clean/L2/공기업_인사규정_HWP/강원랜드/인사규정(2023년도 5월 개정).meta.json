  "delegated_to": [
    "규정의 시행을 위하여 필요한 사항은 사장이 세칙",
    "다른 규정에 특별히 정한 것을 제외하고는 이 규정",
    "직원의 상벌에 관한 세부사항은 세칙",
    "직원의 임용은 이 규정",
    "직원의 직급은 직제규정",
    "징계처분 또는 취업규칙 및 이 규정"
  ],
  "glossary": [
    {
      "term": "임용",
      "definition": "신규채용, 승진, 승호, 전보, 겸직, 파견, 휴직, 복직, 직위해제 및 면직을 말한다."
    },
    {
      "term": "승진",
      "definition": "하위 직급·직위에서 상위 직급·직위로 상승함을 말한다."
    },
    {
      "term": "승호",
      "definition": "동일직급 내에서 상위호봉으로 상승함을 말한다."
    },
    {
      "term": "보직",
      "definition": "직원을 그 자격 및 적성에 따라 일정한 직위를 부여하고 특정직무에 종사하게 함을 말한다."
    },
    {
      "term": "전보",
      "definition": "보직변경이나 부서간 이동을 말한다."
    },
    {
      "term": "복직",
      "definition": "휴직·직위해제 또는 정직 중에 있는 직원을 직위에 복귀시키는 것을 말한다."
    },
    {
      "term": "직위해제",
      "definition": "일정한 기간동안 직위를 해제하는 것을 말한다."
    }
  ]
