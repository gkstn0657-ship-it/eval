  "glossary": [
    {
      "term": "직위",
      "definition": "한 사람의 직원에게 부여할 수 있는 직무와 책임을 말한다."
    },
    {
      "term": "직급",
      "definition": "직무의 종류, 곤란성과 책임도가 상당히 유사한 직위의 군(群)을 말한다."
    },
    {
      "term": "직군",
      "definition": "직무의 성질이 유사한 직종의 군을 말한다."
    },
    {
      "term": "직무",
      "definition": "과업 및 작업의 종류와 수준이 비슷한 업무들의 집합을 말한다."
    },
    {
      "term": "전보",
      "definition": "동일한 직급에 있어서의 보직의 변경을 말한다."
    },
    {
      "term": "승진",
      "definition": "현재의 직급보다 상위의 직급에 임명하는 것을 말한다."
    },
    {
      "term": "강임",
      "definition": "현재의 직급보다 하위의 직급에 임명하는 것을 말한다."
    },
    {
      "term": "정직",
