  "glossary": [
    {
      "term": "직원",
      "definition": "이 규칙에 의해 임용된 자를 말한다."
    },
    {
      "term": "직무",
      "definition": "업무상에서 책임을 지고 담당하여 맡는 사무를 말한다."
    },
    {
      "term": "직위",
      "definition": "1명의 직원에게 부여된 직무와 책임을 말한다."
    },
    {
      "term": "직군",
      "definition": "유사한 직무를 묶은 군을 말한다."
    },
    {
      "term": "SM전문직",
      "definition": "열차 내 접객서비스 업무를 수행하는 승무원을 말한다."
    },
    {
      "term": "전문직",
      "definition": "관광/레저/유통 부분에서 업무를 수행하는 직원을 말한다."
    },
    {
      "term": "공통직",
      "definition": "제17호, 제20호를 제외한 나머지 직원을 말한다."
    },
    {
      "term": "보직",
      "definition": "어떤 직무의 담당을 명함을 말한다."
    },
    {
      "term": "승진",
      "definition": "하위직급에서 상위직급으로 직급이 오르는 것을 말한다."
    },
    {
      "term": "통상근무",
      "definition": "오전에 출근하여 오후에 퇴근하는 일근 근무제를 말한다."
    },
    {
      "term": "교대근무",
      "definition": "조를 편성하여 교대로 근무하는 것을 말한다."
    },
    {
      "term": "교번근무",
      "definition": "승무 근무표에 따라 근무하는 것을 말한다."
    },
    {
      "term": "전보",
      "definition": "보직변경 또는 부서간의 이동을 말한다."
    },
    {
      "term": "공무직",
      "definition": "기간의 정함이 없는 근로계약을 체결한 직원 중 공통직, 전문직. SM전문직을 제외한 직원을 말한다."
    },
    {
      "term": "교육평정",
      "definition": "교육생의 생활태도, 학습태도, 직무능력테스트 등을 종합하여 평정함을 말한다."
    },
    {
      "term": "정기평정",
      "definition": "개인의 업무실적 및 능력을 종합하여 평정함을 말한다."
    }
  ]
}