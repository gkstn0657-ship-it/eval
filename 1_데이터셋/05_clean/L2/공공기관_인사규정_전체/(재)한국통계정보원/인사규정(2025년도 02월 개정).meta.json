  "glossary": [
    {
      "term": "임용",
      "definition": "신규채용, 승진임용, 전보, 겸임, 파견, 휴직, 직위해제, 정직, 복직, 면직 및 파면 등 인사관리에 관한 일체의 발령을 말한다."
    },
    {
      "term": "직급",
      "definition": "직무의 곤란성과 책임도가 상당히 유사한 군을 말한다."
    },
    {
      "term": "직위",
      "definition": "재직기간에 따라 1인의 직원에게 부여하는 호칭을 말한다."
    },
    {
      "term": "직책",
      "definition": "직무상의 책임 및 권한이 부여되는 본부장, 센터장, 실장 등을 말한다."
    },
    {
      "term": "보직",
      "definition": "직원에게 일정한 직무를 지정함을 말한다."
    },
    {
      "term": "전보",
      "definition": "보직변경과 부서간의 이동을 말한다."
    },
    {
      "term": "승진",
      "definition": "하위직급에서 상위직급으로 임용하는 것을 말한다."
    },
    {
      "term": "복직",
      "definition": "휴직 또는 정직중에 있는 직원을 휴직 또는 정직 이전의 직무와 책임에 복직시키는 것을 말한다."
    },
    {
      "term": "파견",
      "definition": "특정한 업무를 수행하기 위하여 근무처를 옮겨 일정기간 동안 근무하는 것을 말한다."
    },
    {
      "term": "중징계",
      "definition": "파면 또는 정직을 말한다."
    },
    {
      "term": "경징계",
      "definition": "감봉 또는 견책을 말한다."
    },
    {
      "term": "직무",
      "definition": "업무수행에 필요한 능력과 기능이 유사한 단위업무의 집합으로서 책임을 갖고 담당하여 맡은 업무를 말한다."
    }
  ]
