  "glossary": [
    {
      "term": "직원",
      "definition": "이 규정에 의하여 채용되어 정보원에 근무하는 자를 말한다."
    },
    {
      "term": "직급",
      "definition": "직무의 곤란성과 책임도가 상당히 유사한 군을 말한다."
    },
    {
      "term": "직위",
      "definition": "재직기간에 따라 1인의 직원에게 부여하는 직무와 책임을 말한다."
    },
    {
      "term": "보직",
      "definition": "직원에게 일정한 직무를 지정함을 말한다."
    },
    {
      "term": "직책",
      "definition": "직무상의 책임 및 권한이 부여되는 본부장, 센터장, 단장, 실장, 팀장 등을 말한다."
    },
    {
      "term": "전보",
      "definition": "보직변경과 부서간의 이동을 말한다."
    },
    {
      "term": "승진",
      "definition": "하위직급에서 상위직급으로 임용하는 것을 말한다."
    },
    {
      "term": "대기발령",
      "definition": "일정한 기간 직무와 책임을 해제함을 말한다."
    },
    {
      "term": "복직",
      "definition": "휴직 또는 정직 중에 있는 직원을 휴직 또는 정직 이전의 직무와 책임에 복직시키는 것을 말한다."
    }
  ]
