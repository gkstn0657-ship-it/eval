  "glossary": [
    {
      "term": "인사",
      "definition": "직원의 임용과 관련되는 일체의 사항을 말한다."
    },
    {
      "term": "임용",
      "definition": "채용·이동·승진·전직·휴직·복직·퇴직을 말한다."
    },
    {
      "term": "승진",
      "definition": "상위 직급으로 임명되는 것을 말한다."
    },
    {
      "term": "근속기간",
      "definition": "입사일 또는 직급발령일부터 기준일까지의 기간을 말한다."
    },
    {
      "term": "임금피크제",
      "definition": "일정연령을 기준으로 임금을 조정하고 전직을 통해 직무, 직급, 직위 등을 별도로 관리하는 제도를 말한다."
    }
  ]
