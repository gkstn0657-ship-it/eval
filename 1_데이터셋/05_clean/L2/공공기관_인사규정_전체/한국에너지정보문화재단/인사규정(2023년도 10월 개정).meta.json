  "glossary": [
    {
      "term": "채용",
      "definition": "직제규정에 의한 직원을 소정의 절차를 거쳐 재단에 근무하게 하는 것을 말한다."
    },
    {
      "term": "배치",
      "definition": "직원에게 일정한 근무부서를 결정하여 주는 것을 말한다."
    },
    {
      "term": "보직",
      "definition": "직원을 직급과 능력 및 적성에 따라 지정한 직무에 종사하게 함을 말한다."
    },
    {
      "term": "이동",
      "definition": "직원을 소속 부서 또는 지정 직무에서 타부서 또는 타 직무에 근무하게 함을 말한다."
    },
    {
      "term": "승진",
      "definition": "승격을 말한다."
    },
    {
      "term": "승격",
      "definition": "하위직급에서 상위직급으로 승진함을 말한다."
    },
    {
      "term": "휴직",
      "definition": "질병 등 본인의 일신상 사정 또는 업무수행 중 발생한 사유로 인하여 일정기간 휴무함을 말한다."
    },
    {
      "term": "정직",
      "definition": "징계처분에 의하여 일정기간 휴무함을 말한다."
    }
  ]
