  "glossary": [
    {
      "term": "직원",
      "definition": "이 규정에 의해 채용된 자를 말한다."
    },
    {
      "term": "직무",
      "definition": "최소단위의 업무를 말한다."
    },
    {
      "term": "전보",
      "definition": "동일한 직급 내에서의 직위 변경 또는 부서간의 이동을 말한다."
    },
    {
      "term": "직위해제",
      "definition": "직원에게 부여한 직무와 책임을 해제하는 것을 말한다."
    },
    {
      "term": "승진",
      "definition": "하위직급에서 상위직급으로 오르는 것을 말한다."
    },
    {
      "term": "면직",
      "definition": "직원의 신분을 해제하는 것을 말한다."
    }
  ]
